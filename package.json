{
  "name": "toygun-gcs",
  "version": "1.0.0",
  "private": true,
  "author": "Toygun",
  "description": "Toygun — PX4 sabit kanatlı araçlar için özelleştirilmiş yer kontrol istasyonu",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "vite --host",
    "dev:electron": "cross-env ELECTRON=true vite --host",
    "build": "cross-env ELECTRON=true vite build",
    "dist:win": "cross-env ELECTRON=true vite build && node scripts/paketleWin.mjs",
    "dist:win:installer": "cross-env ELECTRON=true vite build && electron-builder --win --x64",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@vueuse/core": "^10.9.0",
    "electron-updater": "^6.8.3",
    "leaflet": "^1.9.4",
    "pinia": "^2.1.7",
    "serialport": "^13.0.0",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "vuetify": "^3.7.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.8",
    "@types/node": "^20.11.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "cross-env": "^7.0.3",
    "electron": "^29.2.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2",
    "typescript": "~5.4.4",
    "vite": "^5.2.8",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-vuetify": "^2.0.3",
    "vue-tsc": "^2.0.10"
  },
  "build": {
    "appId": "org.toygun.gcs",
    "productName": "Toygun GCS",
    "copyright": "Copyright © 2024 Toygun",
    "asar": true,
    "asarUnpack": [
      "node_modules/@serialport/bindings-cpp/**"
    ],
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "resources/Masaüstüne_Ekle.bat",
        "to": "Masaüstüne_Ekle.bat"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/toygun-logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Toygun GCS"
    },
    "publish": {
      "provider": "github",
      "owner": "GITHUB_KULLANICI_ADI",
      "repo": "toygun-gcs",
      "releaseType": "release"
    }
  }
}
